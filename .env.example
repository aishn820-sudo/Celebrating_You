# Celebrating YOU — Environment Template (.env.example)

# Database Connection (SQLite for local development, PostgreSQL for production)
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://username:password@db-host:5432/celebrating_you?schema=public"

# JWT Secret (generate a 64+ char random string in production)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"

# Application Environment
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://celebratingyou.com"
ADMIN_PORTAL_HOST="admin.celebratingyou.com"
ADMIN_DOMAIN_ISOLATED="true"

# Cron Security Secret (must match header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generate-a-cryptographically-secure-token-here"

# Payment Gateway (SANDBOX or RAZORPAY)
PAYMENT_GATEWAY_PROVIDER="SANDBOX"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

