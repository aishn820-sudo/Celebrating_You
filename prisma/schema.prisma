datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    // "CUSTOMER", "VENDOR", "ADMIN"
  isFirstLogin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer?
  vendor        Vendor?
  notifications Notification[]
  auditLogs     AuditLog[]
}

// 2. Customers
model Customer {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerCode  String    @unique // e.g. "CY-CUST-1001"
  name          String
  phone         String
  email         String
  address       String?
  city          String?
  state         String?
  pincode       String?
  preferences   String?   // JSON string of preferences
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events        Event[]
  bookings      Booking[]
  payments      Payment[]
  reviews       Review[]
  complaints    Complaint[]
}

// 3. Vendors
model Vendor {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorCode           String    @unique // e.g. "CY-VEND-2001"
  businessName         String
  contactPerson        String
  email                String
  phone                String
  city                 String
  state                String
  pincode              String?
  serviceAreas         String?   // comma separated or JSON
  categoryId           String
  category             VendorCategory @relation(fields: [categoryId], references: [id])
  gstin                String?
  panNumber            String?
  bankAccountNumber    String?
  bankIfsc             String?
  bankName             String?
  accountHolderName    String?
  verificationStatus   String    @default("PENDING") // "PENDING", "INFO_REQUIRED", "VERIFIED", "REJECTED", "SUSPENDED"
  isVerified           Boolean   @default(false)
  canPublish           Boolean   @default(false)
  rating               Float     @default(5.0)
  reviewCount          Int       @default(0)
  commissionRate       Float     @default(10.0) // Platform commission %
  maxWeeklyDeclines    Int       @default(3)
  declineCountCurrentWeek Int    @default(0)
  responseTimeMinutes  Int       @default(15)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  verifications        VendorVerification[]
  documents            VendorDocument[]
  services             Service[]
  availabilities       ServiceAvailability[]
  bookings             Booking[]
  settlements          VendorSettlement[]
  reviews              Review[]
  complaints           Complaint[]
  promotions           VendorPromotion[]
}

// 4. VendorVerification
model VendorVerification {
  id                 String    @id @default(cuid())
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedByAdminId  String?
  status             String    // "PENDING", "APPROVED", "REJECTED", "INFO_REQUIRED"
  rejectionReason    String?
  remarks            String?
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
}

// 5. VendorDocuments
model VendorDocument {
  id                 String    @id @default(cuid())
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType       String    // "ID_PROOF", "BUSINESS_REGISTRATION", "TAX_CERTIFICATE", "PORTFOLIO_PROOF", "OTHER"
  documentName       String
  fileUrl            String
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  uploadedAt         DateTime  @default(now())
  reviewedAt         DateTime?
}

// 6. VendorCategories
model VendorCategory {
  id                 String    @id @default(cuid())
  name               String    @unique
  slug               String    @unique
  description        String?
  icon               String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendors            Vendor[]
  services           Service[]
  commissionSettings CommissionSetting[]
}

// 7. Services
model Service {
  id                 String    @id @default(cuid())
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId         String
  category           VendorCategory @relation(fields: [categoryId], references: [id])
  title              String
  slug               String
  description        String
  basePrice          Int       // Integer minor units (e.g. ₹5000 = 500000 paise or 5000 INR)
  status             String    @default("DRAFT") // "DRAFT", "PUBLISHED", "INACTIVE"
  capacity           String?
  duration           String?
  setupTime          String?
  inclusions         String?   // JSON array string
  exclusions         String?   // JSON array string
  termsConditions    String?
  cancellationPolicy String?
  travelCharges      Int       @default(0)
  isApprovedByAdmin  Boolean   @default(true)
  rating             Float     @default(5.0)
  reviewCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  packages           ServicePackage[]
  images             ServiceImage[]
  addons             ServiceAddon[]
  availabilities     ServiceAvailability[]
  eventServices      EventService[]
  bookings           Booking[]
  reviews            Review[]
}

// 8. ServicePackages
model ServicePackage {
  id                 String    @id @default(cuid())
  serviceId          String
  service            Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  price              Int       // minor units (paise)
  advancePercent     Int       @default(25) // e.g. 25%
  features           String?   // JSON array string
  duration           String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  bookings           Booking[]
  eventServices      EventService[]
}

// 9. ServiceImages
model ServiceImage {
  id                 String    @id @default(cuid())
  serviceId          String
  service            Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageUrl           String
  isCover            Boolean   @default(false)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
}

// 10. ServiceAddons
model ServiceAddon {
  id                 String    @id @default(cuid())
  serviceId          String
  service            Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  price              Int       // minor units (paise)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

// 11. ServiceAvailability
model ServiceAvailability {
  id                 String    @id @default(cuid())
  serviceId          String?
  service            Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date               String    // "YYYY-MM-DD"
  isBlocked          Boolean   @default(true)
  reason             String?
  createdAt          DateTime  @default(now())
}

// 12. Events
model Event {
  id                 String    @id @default(cuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId         String?
  template           EventTemplate? @relation(fields: [templateId], references: [id])
  title              String
  eventType          String    // "Birthday", "Wedding", "Anniversary", etc.
  eventDate          String    // "YYYY-MM-DD"
  eventTime          String?   // e.g. "18:00"
  locationAddress    String
  city               String
  state              String
  pincode            String?
  guestCount         Int       @default(50)
  overallBudget      Int       // minor units (paise)
  notes              String?
  status             String    @default("PLANNING") // "PLANNING", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checkpoints        EventCheckpoint[]
  eventServices      EventService[]
  bookings           Booking[]
}

// 13. EventTemplates
model EventTemplate {
  id                       String    @id @default(cuid())
  name                     String    @unique
  slug                     String    @unique
  description              String
  category                 String
  suggestedBudgetMin       Int       // minor units (paise)
  suggestedBudgetMax       Int       // minor units (paise)
  defaultGuestCount        Int       @default(50)
  stagesJson               String    // JSON array of stages
  recommendedServicesJson  String    // JSON array of recommended services/categories
  checkpointsJson          String    // JSON array of checkpoint templates
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())

  events                   Event[]
}

// 14. EventCheckpoints
model EventCheckpoint {
  id                 String    @id @default(cuid())
  eventId            String
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  targetDate         String?   // "YYYY-MM-DD"
  status             String    @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED"
  isCustom           Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

// 15. EventServices
model EventService {
  id                 String    @id @default(cuid())
  eventId            String
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service   @relation(fields: [serviceId], references: [id])
  packageId          String?
  package            ServicePackage? @relation(fields: [packageId], references: [id])
  status             String    @default("SHORTLISTED") // "SHORTLISTED", "BOOKED", "REMOVED"
  notes              String?
  budgetAllocated    Int       @default(0) // minor units
  createdAt          DateTime  @default(now())

  @@map("EventServices")
}

// 16. Bookings
model Booking {
  id                        String    @id @default(cuid())
  bookingCode               String    @unique // e.g. "CY-BK-5001"
  eventId                   String
  event                     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer  @relation(fields: [customerId], references: [id])
  vendorId                  String
  vendor                    Vendor    @relation(fields: [vendorId], references: [id])
  serviceId                 String
  service                   Service   @relation(fields: [serviceId], references: [id])
  packageId                 String?
  package                   ServicePackage? @relation(fields: [packageId], references: [id])
  eventDate                 String    // "YYYY-MM-DD"
  status                    String    @default("REQUEST_SUBMITTED")
  // Statuses:
  // "DRAFT", "REQUEST_SUBMITTED", "AWAITING_VENDOR_RESPONSE", "ACCEPTED_AWAITING_ADVANCE",
  // "CONFIRMED", "IN_PROGRESS", "COMPLETED", "DECLINED", "EXPIRED", "CANCELLED",
  // "REFUND_PENDING", "REFUNDED", "DISPUTED"

  requestSubmittedAt        DateTime  @default(now())
  responseDeadlineAt        DateTime? // EXACTLY 2 hours after requestSubmittedAt
  acceptedAt                DateTime?
  declinedAt                DateTime?
  declineReason             String?
  confirmedAt               DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?

  agreedServiceValue        Int       // minor units (paise)
  advanceRequired           Int       // minor units (paise)
  advancePaid               Int       @default(0) // minor units (paise)
  finalBalanceDue           Int       // minor units (paise)
  finalPaid                 Int       @default(0) // minor units (paise)

  specialRequirements       String?
  guestCount                Int?
  locationAddress           String?

  isCustomerContactRevealed Boolean   @default(false)
  isVendorContactRevealed   Boolean   @default(false)

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  statusHistory             BookingStatusHistory[]
  issues                    BookingIssue[]
  payments                  Payment[]
  transactions              PaymentTransaction[]
  invoices                  Invoice[]
  settlements               VendorSettlement[]
  refunds                   Refund[]
  reviews                   Review[]
  complaints                Complaint[]
}

// 17. BookingStatusHistory
model BookingStatusHistory {
  id                 String    @id @default(cuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus         String
  toStatus           String
  changedByRole      String    // "CUSTOMER", "VENDOR", "ADMIN", "SYSTEM"
  changedByUserId    String?
  note               String?
  timestamp          DateTime  @default(now())
}

// 18. BookingIssues
model BookingIssue {
  id                 String    @id @default(cuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reporterRole       String    // "CUSTOMER", "VENDOR"
  reporterUserId     String
  title              String
  description        String
  attachmentsJson    String?   // JSON array of file URLs
  status             String    @default("OPEN") // "OPEN", "IN_INVESTIGATION", "RESOLVED", "REJECTED"
  resolution         String?
  resolvedByAdminId  String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 19. Payments
model Payment {
  id                 String    @id @default(cuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  totalAmount        Int       // minor units (paise)
  paidAmount         Int       @default(0) // minor units (paise)
  pendingAmount      Int       // minor units (paise)
  status             String    @default("PENDING") // "PENDING", "PARTIALLY_PAID", "FULLY_PAID", "REFUNDED"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transactions       PaymentTransaction[]
}

// 20. PaymentTransactions
model PaymentTransaction {
  id                 String    @id @default(cuid())
  paymentId          String
  payment            Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionRef     String    @unique // e.g. "CY-TXN-202611-XXXX"
  type               String    // "ADVANCE", "FINAL", "ADDON", "REFUND"
  amount             Int       // minor units (paise)
  currency           String    @default("INR")
  status             String    @default("INITIATED") // "INITIATED", "SUCCESS", "FAILED"
  gatewayProvider    String    @default("SANDBOX") // "RAZORPAY", "SANDBOX", "MANUAL"
  gatewayOrderId     String?
  gatewayPaymentId   String?
  gatewaySignature   String?
  idempotencyKey     String?   @unique
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  invoices           Invoice[]
  refunds            Refund[]
}

// 21. Invoices
model Invoice {
  id                     String    @id @default(cuid())
  invoiceNumber          String    @unique // e.g. "CY-INV-ADV-1001", "CY-INV-FIN-1001"
  bookingId              String
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId          String
  transaction            PaymentTransaction @relation(fields: [transactionId], references: [id])
  type                   String    // "ADVANCE", "FINAL"
  customerName           String
  customerEmail          String
  customerPhone          String
  customerAddress        String?
  vendorBusinessName     String
  vendorGstin            String?
  vendorPan              String?
  vendorAddress          String?
  serviceTitle           String
  packageName            String?
  agreedServiceValue     Int       // minor units (paise)
  advancePaid            Int       @default(0) // minor units (paise)
  amountPaidThisDoc      Int       // minor units (paise)
  remainingBalanceDue    Int       @default(0) // minor units (paise)
  taxAmount              Int       @default(0) // minor units (paise)
  paymentDate            DateTime  @default(now())
  status                 String    @default("ISSUED") // "ISSUED", "PAID", "CANCELLED"
  pdfUrl                 String?
  createdAt              DateTime  @default(now())
}

// 22. VendorSettlements
model VendorSettlement {
  id                     String    @id @default(cuid())
  vendorId               String
  vendor                 Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookingId              String
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount            Int       // minor units (paise)
  platformCommission     Int       // minor units (paise)
  commissionPercent      Float     @default(10.0)
  netSettlementAmount    Int       // minor units (paise) = grossAmount - platformCommission
  status                 String    @default("DUE") // "DUE", "PROCESSING", "SETTLED"
  settledAt              DateTime?
  settlementRef          String?
  remarks                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// 23. Refunds
model Refund {
  id                     String    @id @default(cuid())
  bookingId              String
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentTransactionId   String?
  transaction            PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  amount                 Int       // minor units (paise)
  reason                 String
  status                 String    @default("REQUESTED") // "REQUESTED", "APPROVED", "PROCESSED", "REJECTED"
  approvedByAdminId      String?
  processedAt            DateTime?
  refundRef              String?
  createdAt              DateTime  @default(now())
}

// 24. Reviews
model Review {
  id                 String    @id @default(cuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id])
  serviceId          String
  service            Service   @relation(fields: [serviceId], references: [id])
  rating             Int       // 1-5 stars
  comment            String
  vendorReply        String?
  isFlagged          Boolean   @default(false)
  isApproved         Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 25. Notifications
model Notification {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String    // "CUSTOMER", "VENDOR", "ADMIN"
  title              String
  message            String
  link               String?
  type               String    @default("BOOKING") // "BOOKING", "PAYMENT", "SYSTEM", "ALERT"
  isRead             Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

// 26. Complaints
model Complaint {
  id                 String    @id @default(cuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id])
  subject            String
  description        String
  priority           String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status             String    @default("OPEN") // "OPEN", "INVESTIGATING", "RESOLVED", "CLOSED"
  adminNotes         String?
  resolvedByAdminId  String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 27. CommissionSettings
model CommissionSetting {
  id                       String    @id @default(cuid())
  categoryId               String?
  category                 VendorCategory? @relation(fields: [categoryId], references: [id])
  defaultCommissionPercent Float     @default(10.0)
  minCommissionPercent     Float     @default(5.0)
  maxCommissionPercent     Float     @default(20.0)
  isDefault                Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// 28. PlatformSettings
model PlatformSetting {
  id                 String    @id @default(cuid())
  key                String    @unique
  value              String
  description        String?
  updatedAt          DateTime  @updatedAt
}

// 29. AuditLogs
model AuditLog {
  id                 String    @id @default(cuid())
  adminId            String?
  admin              User?     @relation(fields: [adminId], references: [id])
  action             String    // "APPROVE_VENDOR", "UPDATE_COMMISSION", "REFUND_APPROVED", etc.
  targetEntity       String    // "Vendor", "Booking", "Setting"
  targetId           String?
  previousValue      String?
  newValue           String?
  ipAddress          String?
  timestamp          DateTime  @default(now())
}

// 30. VendorPromotions
model VendorPromotion {
  id                 String    @id @default(cuid())
  vendorId           String
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title              String
  promoCode          String
  discountPercent    Int
  maxDiscount        Int?
  validFrom          DateTime
  validUntil         DateTime
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
}
